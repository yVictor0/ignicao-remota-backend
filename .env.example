# Senha que você digita no site para poder ligar o PC (use algo longo)
APP_PASSWORD=troque-por-uma-senha-longa

# Chave que só o ESP32 conhece (a mesma vai no firmware/config.h)
DEVICE_API_KEY=troque-por-uma-chave-aleatoria-grande

# Endereço(s) do frontend permitidos no CORS, separados por vírgula
# Ex.: https://meu-wol.vercel.app,http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Upstash Redis (a integração da Vercel preenche isso sozinha;
# também funcionam os nomes KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
